# Copy this file to .env and replace both values with independent 32-byte keys.
# Generate them with:
#   python -m au_ledger init-keys --out solution/.env
# The real .env file is ignored by git and must never be committed.
AU_PII_ENC_KEY=replace-with-base64-encoded-32-byte-key
AU_PII_HMAC_KEY=replace-with-a-different-base64-encoded-32-byte-key
